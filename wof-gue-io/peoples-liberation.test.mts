import assert from 'node:assert/strict';
import {LIBERATION_BASE_DRONES,LIBERATION_DRONE_DAMAGE,LIBERATION_ORB_DAMAGE,LIBERATION_DOME_MAX,createLiberation,liberationWeights,chooseLiberationCharacter,liberationOrbChance,liberationFreezeSeconds,liberationExplosionMaxTier,liberationFormationSeconds,liberationDronePosition,chooseLiberationLinks,spendLiberationLinks,absorbLiberationHit,beginLiberationSun,tickLiberation,disperseLiberationArmour,beginLiberationScan,finishLiberationScan,liberationElitePosition,liberationEffectPlan} from './src/game/peoples-liberation';
assert.equal(LIBERATION_BASE_DRONES,150);assert.equal(LIBERATION_DRONE_DAMAGE,7_000_000);assert.equal(LIBERATION_ORB_DAMAGE,777_000_000);assert.equal(LIBERATION_DOME_MAX,15000);
const weights=liberationWeights();assert(Math.abs(weights['定']-.3)<1e-12 && Math.abs(weights['天']-.1)<1e-12);assert.equal(chooseLiberationCharacter({},()=>.05),'定');assert.equal(chooseLiberationCharacter({},()=>.35),'死');assert.equal(chooseLiberationCharacter({},()=>.65),'爆');assert.equal(chooseLiberationCharacter({},()=>.95),'天');
const upgraded=liberationWeights({drones:5});assert.equal(upgraded['天'],.2);assert(Math.abs(Object.values(upgraded).reduce((a,b)=>a+b,0)-1)<1e-12);assert.equal(liberationOrbChance(),.3);assert(Math.abs(liberationOrbChance({orbChance:10})-.75)<1e-12);assert.equal(liberationFreezeSeconds(),10);assert.equal(liberationExplosionMaxTier(),3);assert.equal(liberationExplosionMaxTier({blastRarity:2}),5);assert(liberationFormationSeconds({activationSpeed:10})<2);
const s=createLiberation();assert.equal(s.drones.length,150);assert.equal(s.dome,15000);const links=chooseLiberationLinks(s,()=>0);assert.equal(links.length,5);assert.equal(new Set(links).size,5);assert(spendLiberationLinks(s,links));assert(!spendLiberationLinks(s,links));assert.equal(s.drones.filter(Boolean).length,145);assert.equal(absorbLiberationHit(s,1e9,()=>0),0);assert.equal(s.drones.filter(Boolean).length,144);
assert(!beginLiberationSun(s,{},()=>.99),'chance failure does not start activation');s.drones.fill(false);assert(beginLiberationSun(s,{},()=>.95),'exhaustion guarantees activation');assert.equal(s.selected,'天');assert(!beginLiberationSun(s,{},()=>0),'cannot retrigger during activation');
let effects:string[]=[];for(let i=0;i<30;i++){const effect=tickLiberation(s,.2,119);if(effect)effects.push(effect);}assert.deepEqual(effects,['天']);assert.equal(s.stage,'armour');assert.equal(s.armourMax,1190);assert(!disperseLiberationArmour(s));for(let i=0;i<30;i++)tickLiberation(s,.2,119);assert(s.drones.every(Boolean));assert(disperseLiberationArmour(s));for(let i=0;i<5;i++)tickLiberation(s,.2,119);assert.equal(s.stage,'idle');
s.drones.fill(false);s.dome=100;assert.equal(absorbLiberationHit(s,150,()=>0),50);assert.equal(s.dome,0);
for(let i=0;i<150;i++){const p=liberationDronePosition(i,150,2,100,-50);assert(p.every(Number.isFinite));assert(Math.hypot(p[0]-100,p[1]+50)<300);}
assert.throws(()=>chooseLiberationCharacter({},()=>1));assert.throws(()=>tickLiberation(s,1,100));console.log('People’s Liberation isolated state: distribution, swarm, damage layers, activation and sequential recharge');

const scan=createLiberation();assert(beginLiberationScan(scan,7,[{id:1,alive:true},{id:2,alive:false},{id:3,alive:true}],.5));assert.deepEqual(scan.scanParts,[1,3]);assert(!finishLiberationScan(scan,true));for(let i=0;i<3;i++)tickLiberation(scan,.2,100);assert(finishLiberationScan(scan,true));assert.equal(scan.lockEnemy,7);assert(beginLiberationScan(scan,8,[{id:0,alive:true}],.1));tickLiberation(scan,.2,100);assert(!finishLiberationScan(scan,false));assert.equal(scan.lockEnemy,null);assert.deepEqual(liberationElitePosition(0,0,10,20,50),[60,20]);assert.equal(liberationEffectPlan('爆',{blastRarity:2}).explosionMaxTier,5);
