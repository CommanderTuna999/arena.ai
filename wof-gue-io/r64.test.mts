import assert from 'node:assert/strict';
import { Game } from './src/game/engine';
import { newSave } from './src/game/data';
import { readFileSync } from 'node:fs';
const g=new Game(newSave(),'test') as any;
const e=g.makeEnemy(0,0,5000,5000,'test',11), p=e.parts[e.coreId];
g.damagePart(e,p,10,5000,5000,'kinetic',false,true);
assert.equal(g.damageNumbers.length,1);
assert.equal(g.damageNumbers[0].amount,10); assert.equal(g.damageNumbers[0].kind,'kinetic'); assert(g.damageNumbers[0].crit);
g.damagePart(e,p,5,5000,5000,'laser');
assert.equal(g.damageNumbers[1].kind,'laser');
g.damagePart(e,p,2,5000,5000,'dot');g.damagePart(e,p,3,5000,5000,'dot');
assert.equal(g.damageNumbers[2].amount,5);
for(let i=0;i<150;i++) g.damageNumber(i*1000,0,1,'explosive');
assert(g.damageNumbers.length<=80);
const r=readFileSync('src/game/render.ts','utf8');
assert(r.includes('CRIT')); assert(r.includes('DAMAGE_COLORS')); assert(!r.includes('ZONE_EDGES.forEach'));
const ui=readFileSync('src/components/GameClient.tsx','utf8'); assert(!ui.includes('bg-[#050e16]/97'));
console.log('Damage number and map tests passed');
