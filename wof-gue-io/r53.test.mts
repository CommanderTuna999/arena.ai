import assert from "node:assert/strict";
import { Game } from "./src/game/engine";
import { BASE, computeStats, newSave } from "./src/game/data";
import { SPECIES_LIST } from "./src/game/enemies";
const moth = SPECIES_LIST.find(s => s.id === "moth")!;
assert.equal(moth.abilities.find(a => a.name === "Rotating Lasers")?.dmg, 7);
const g = new Game(newSave(), "test") as any;
g.save.cannon.id = "fencer"; g.stats = computeStats(g.save);
g.player.x = BASE.x + 2000; g.player.y = BASE.y; g.player.a = 0; g.input.lmb = true;
g.player.fenceShots = 4; g.player.fireCd = 0;
const calls: any[][] = []; g.beam = (...args: any[]) => calls.push(args);
g.firePlayer(0.05);
assert(g.fencerCharge > 0 && calls.length === 0, "fifth shot begins charging rather than firing");
for (let i=0; i<9; i++) g.firePlayer(0.05);
assert.equal(calls.length, 1); assert.equal(calls[0][7], "laser");
assert(g.player.vx <= -190, "charged shot recoils");
const e = g.makeEnemy(0, 1, 3000, 3000, "test", 7);
for (const p of e.parts) p.alive = true;
e.parts[e.coreId].links = [];
const detached = e.parts.filter((p: any) => p.id !== e.coreId).length;
let drops = 0; g.maybeDrop = () => { drops++; }; g.checkSever(e, true);
assert.equal(drops, detached, "every disconnected piece rolls for a drop");
console.log("r53 regression checks passed");
