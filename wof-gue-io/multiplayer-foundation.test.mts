import assert from 'node:assert/strict';
import { InputBuffer, parseInput } from './src/game/multiplayer/input';
import { SimulationClock } from './src/game/multiplayer/clock';
const frame = { seq: 0, forward: true, backward: false, left: false, right: true, fire: true, boost: false, aim: 0, x: 999999, damage: 99999 };
const parsed = parseInput(frame, -1)!;
assert(parsed); assert(!('x' in parsed)); assert(!('damage' in parsed));
assert.equal(parseInput({ ...frame, aim: Infinity }, -1), null);
assert.equal(parseInput({ ...frame, seq: 0 }, 0), null);
assert.equal(parseInput({ ...frame, forward: 1 }, -1), null);
const b = new InputBuffer();
assert(b.receive('a', frame, 100)); assert(b.receive('b', { ...frame, fire: false }, 100));
assert(!b.receive('a', frame, 101)); assert.equal(b.get('a', 200).fire, true); assert.equal(b.get('b', 200).fire, false);
assert.equal(b.get('a', 1101).fire, false); assert(!b.receive('a', { ...frame, seq: 1 }, 90));
b.remove('a'); assert.equal(b.get('a', 200).forward, false);
const clock = new SimulationClock(0.05, 3); let elapsed = 0;
assert.equal(clock.advance(0, dt => elapsed += dt), 0);
assert.equal(clock.advance(100, dt => elapsed += dt), 2); assert(Math.abs(elapsed - 0.1) < 1e-9);
assert.equal(clock.advance(10100, dt => elapsed += dt), 3); assert(Math.abs(elapsed - 0.25) < 1e-9);
assert.equal(clock.advance(10000, () => { throw Error('clock went backwards'); }), 0);
console.log('Server input and fixed-step foundation checks passed');
