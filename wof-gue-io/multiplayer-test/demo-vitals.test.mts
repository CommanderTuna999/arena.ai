import assert from 'node:assert/strict';import {JSDOM} from 'jsdom';import {createChairman,gatherChairmanArmour} from './source/src/game/chairman';
const dom=new JSDOM('<div id="vitals"></div>',{pretendToBeVisual:true});Object.assign(globalThis,{window:dom.window,document:dom.window.document});
const {createDemoHud}=await import('./source/src/game/multiplayer/testing/demo/demo-hud');const hud=createDemoHud(document.querySelector('#vitals')!);const flush=()=>new Promise(r=>setTimeout(r,25));
const c=createChairman(),p={hp:80,hpMax:100,shield:25,shieldMax:60,cannonId:'chairman',boost:45,hasBoost:true,chairman:c};hud.update(p);await flush();
assert(document.querySelector('svg[aria-label="Health: 80 of 100"]'));assert(document.querySelector('svg[aria-label="Shield: 25 of 60"]'));const dome=document.querySelector('svg[aria-label^="Dome:"]') as SVGElement;assert(dome,'red dome uses authoritative state');assert.equal(dome.querySelector('path[stroke]')?.getAttribute('stroke'),'#ff344a');assert.equal(document.querySelector('[aria-label="Afterburner"]')?.getAttribute('aria-valuenow'),'45');
