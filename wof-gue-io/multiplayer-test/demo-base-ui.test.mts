import assert from 'node:assert/strict';import {spawn} from 'node:child_process';import {once} from 'node:events';import {createServer} from 'node:net';import {WebSocket} from 'ws';import {JSDOM} from 'jsdom';import {CANNONS} from './source/src/game/data';
const probe=createServer();probe.listen(0,'127.0.0.1');await once(probe,'listening');const port=(probe.address() as any).port;await new Promise<void>(r=>probe.close(()=>r()));const base=`http://127.0.0.1:${port}`;
const child=spawn('node',['multiplayer-test/start.cjs'],{env:{...process.env,PORT:String(port)},stdio:['ignore','pipe','pipe']});child.stderr!.on('data',d=>process.stderr.write(d));await Promise.race([new Promise<void>((resolve,reject)=>{child.stdout!.on('data',d=>{if(String(d).includes('listening'))resolve()});child.on('exit',()=>reject(Error('server exited')))}),new Promise((_,reject)=>setTimeout(()=>reject(Error('startup timeout')),10000))]);
const until=async(fn:()=>boolean,desc:string)=>{const end=Date.now()+10000;while(Date.now()<end){if(fn())return;await new Promise(r=>setTimeout(r,25));}throw Error('Timed out: '+desc+' error='+String((globalThis as any).__demoError))};
let dom:JSDOM|undefined;
try{
 const html=await fetch(base).then(r=>r.text()),script=await fetch(base+'/demo.js').then(r=>r.text());dom=new JSDOM(html,{url:base,runScripts:'outside-only',pretendToBeVisual:true});const win=dom.window;let browserError:unknown=null;win.addEventListener('error',e=>{browserError=e.error;(globalThis as any).__demoError=e.error;e.preventDefault()});
 const grad={addColorStop(){}};const paint=new Proxy({createRadialGradient:()=>grad,createLinearGradient:()=>grad,measureText:()=>({width:30})},{get:(t,k)=>k in t?(t as any)[k]:()=>{},set:(t,k,v)=>{(t as any)[k]=v;return true}});(win.HTMLCanvasElement.prototype as any).getContext=()=>paint;(win as any).fetch=(url:string,o:any)=>fetch(new URL(url,base),o);(win as any).structuredClone=structuredClone;(win as any).WebSocket=function(url:string){return new WebSocket(url,{origin:base})};win.eval(script);
 await until(()=>!!win.document.querySelector('#status')?.textContent?.includes('pilot'),'guest online');win.dispatchEvent(new win.KeyboardEvent('keydown',{code:'KeyE',bubbles:true}));
 const shadow=()=>Array.from(win.document.querySelectorAll('div')).map(e=>e.shadowRoot).find(Boolean)!;await until(()=>!!shadow()?.textContent?.includes('CANNON TREE'),'base menu open');
 const tree=shadow();for(const c of CANNONS)assert(tree.textContent!.includes(c.name),`${c.name} appears in the real tree`);
 const revolutionary=tree.querySelector('button[title="Revolutionary — view upgrades"]') as HTMLButtonElement;assert(revolutionary);revolutionary.click();await until(()=>!!tree.textContent?.includes('BRANCH · REVOLUTIONARY'),'equip shows correct upgrade branch');
 const levelBefore=tree.textContent;const plus=Array.from(tree.querySelectorAll('button')).find(b=>b.textContent?.trim()==='+1') as HTMLButtonElement;assert(plus&&!plus.disabled);plus.click();await until(()=>tree.textContent!==levelBefore && !!tree.textContent?.includes('LV 1/'),'server-confirmed upgrade');
 win.dispatchEvent(new win.KeyboardEvent('keydown',{code:'Escape',bubbles:true}));await until(()=>!tree.textContent?.includes('CANNON TREE')&&!tree.textContent?.includes('BRANCH ·'),'close menu');assert.equal(browserError,null);
 win.dispatchEvent(new win.Event('pagehide'));win.close();console.log('Browser bundle: real cannon tree displays every chassis, equips Revolutionary and upgrades via server');
}finally{dom?.window.close();child.kill();}
