import assert from 'node:assert/strict';
import {Game} from './source/src/game/engine';import {newSave,BASE,UPGRADES} from './source/src/game/data';import {CombatHarness} from './source/src/game/multiplayer/combat-harness';import {ReplicaView} from './source/src/game/multiplayer/replica-view';
const world=new Game(newSave(),'world'),h=new CombatHarness(world,2,false,undefined,undefined,true);assert(h.roster.add('a','Alpha'));assert(h.roster.add('b','Beta'));const a=h.roster.get('a')!,b=h.roster.get('b')!;
a.player.hp=50;a.player.shield=20;assert(h.roster.upgradeDemoShip('a','hull',1));assert.equal(a.stats.hull,119);assert.equal(a.player.hp,69,'only additional max health is granted, not a full heal');assert(h.roster.upgradeDemoShip('a','shield',1));assert(Math.abs(a.player.shield-33.2)<1e-9);assert.equal(b.stats.hull,100);assert.equal(b.stats.shieldMax,60);
assert(!h.roster.upgradeDemoShip('a','drops',1),'unsupported salvage not accepted');assert(!h.roster.upgradeDemoShip('a','constructor',1));assert(!h.roster.upgradeDemoShip('a','hull',30),'levels cannot exceed maximum');assert(!h.roster.upgradeDemoShip('a','regen',-1));assert(!h.roster.upgradeDemoShip('a','regen',1.5));
assert(h.roster.upgradeDemoShip('a','thrust',1));assert(h.roster.upgradeDemoShip('a','handling',1));assert(h.roster.upgradeDemoShip('a','boost',1));assert(h.roster.upgradeDemoShip('a','regen',1));assert(h.roster.upgradeDemoShip('a','armor',1));assert(a.stats.hasBoost);assert(a.stats.armor>0);assert.equal(a.stats.thrust,490);
const snapshot=h.snapshot(),view=new ReplicaView();assert(view.apply(snapshot,snapshot.pilots,snapshot.enemies,'a'));assert.equal(view.game.stats.hull,a.stats.hull);assert.equal(view.game.stats.shieldMax,a.stats.shieldMax);assert.equal(view.game.stats.thrust,a.stats.thrust);
const input={seq:1,forward:false,backward:false,left:false,right:true,boost:true,fire:false,aim:0};assert(h.roster.receive('a',input,1000));assert(h.roster.receive('b',input,1000));h.step(.05,1000);assert(a.player.boosting);assert(!b.player.boosting,'another guest cannot use unlocked boost');
assert(h.roster.equipDemoCannon('a','chairman'));assert(a.chairman);a.player.x=BASE.x+BASE.r+50;assert(!h.roster.upgradeDemoShip('a','hull',1),'server rejects upgrades outside base');a.player.x=BASE.x;a.player.dead=true;assert(!h.roster.upgradeDemoShip('a','hull',1),'dead pilots cannot upgrade');
assert.equal(UPGRADES.filter(u=>['hull','mobility'].includes(u.cat)).length,7);
console.log('Guest ship upgrades validate at base, affect authoritative stats and remain pilot-isolated');
